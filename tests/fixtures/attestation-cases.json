    "signals": {
      "is_ai": true,
      "pr": {
        "head_sha_at_merge": "abc123",
        "reviews": [
          {"state": "APPROVED", "author_type": "User", "author_login": "alice", "commit_id": "abc123"},
          {"state": "DISMISSED", "author_type": "User", "author_login": "alice", "commit_id": "abc123"}
        ]
      }
    },
    "expected_attestation": {"kind": "unattested", "reason": "human-commented"}
  },
  {
    "description": "bot approval only",
    "signals": {
      "is_ai": true,
      "pr": {
        "head_sha_at_merge": "abc123",
        "reviews": [
          {"state": "APPROVED", "author_type": "Bot", "author_login": "codecov", "commit_id": "abc123"}
        ]
      }
    },
    "expected_attestation": {"kind": "unattested", "reason": "ai-reviewed-only"}
  },
  {
    "description": "bot comment only",
    "signals": {
      "is_ai": true,
      "pr": {
        "head_sha_at_merge": "abc123",
        "reviews": [
          {"state": "COMMENTED", "author_type": "Bot", "author_login": "codecov", "commit_id": "abc123"}
        ]
      }
    },
    "expected_attestation": {"kind": "unattested", "reason": "ai-reviewed-only"}
  },
  {
    "description": "multiple bots, no human",
    "signals": {
      "is_ai": true,
      "pr": {
        "head_sha_at_merge": "abc123",
        "reviews": [
          {"state": "APPROVED", "author_type": "Bot", "author_login": "codecov", "commit_id": "abc123"},
          {"state": "COMMENTED", "author_type": "Bot", "author_login": "dependabot", "commit_id": "abc123"}
        ]
      }
