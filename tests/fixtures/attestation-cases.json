    "expected_attestation": {"kind": "unattested", "reason": "ai-reviewed-only"}
  },
  {
    "description": "human approved old SHA + different human commented",
    "signals": {
      "is_ai": true,
      "pr": {
        "head_sha_at_merge": "def456",
        "reviews": [
          {"state": "APPROVED", "author_type": "User", "author_login": "alice", "commit_id": "aaa111"},
          {"state": "COMMENTED", "author_type": "User", "author_login": "bob", "commit_id": "def456"}
        ]
      }
